# Copy → .env.local (gitignored). Never commit real passwords.
GOVONE_BASE_URL=https://pmdb.govone.vn
GOVONE_APPS_PATH=/apps.aspx
GOVONE_USER=
GOVONE_PASS=

# Optional selectors (ASP.NET / gServer — override nếu DOM đổi)
# GOVONE_USER_SELECTOR=input[type="text"], input[name*="User"], input[id*="User"]
# GOVONE_PASS_SELECTOR=input[type="password"]
# GOVONE_SUBMIT_SELECTOR=input[type="submit"], button[type="submit"], button:has-text("Đăng nhập")

# Crawl limits
GOVONE_MAX_PAGES=80
GOVONE_MAX_MENU=120
# deep/full: false = hiện browser theo dõi; true = ẩn (CI)
GOVONE_HEADLESS=false
GOVONE_SLOW_MO=80
GOVONE_SCREENSHOTS=true

# Rescan — all menus + action forms + reload retry + optional pause/manual
# GOVONE_MODE=rescan
# GOVONE_MASTER=maintenance
# GOVONE_MASTERS=maintenance,patrol,incident
# GOVONE_ALL_MENUS=true
# GOVONE_ALL_ACTION_FORMS=true
# GOVONE_RETRY=2
# GOVONE_PAUSE_ON_FAIL=true
# GOVONE_MAX_INNER=200
# GOVONE_MAX_CREATE=20

# Output under Docs (relative to Linm.RMMS.Data)
# GOVONE_OUT_DIR=docs/context/_raw/legacy-govone
